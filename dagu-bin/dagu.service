[Unit]
Description=Dagu Workflow Engine
Documentation=https://docs.dagu.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dagu
Group=dagu
# DAGU_HOME 必须进进程环境：start-all 的 --dagu-home 不会传给再 fork 出的 `dagu start`。
Environment=DAGU_HOME=/var/lib/dagu
EnvironmentFile=-/etc/dagu/environment
ExecStart=/usr/bin/dagu start-all --dagu-home /var/lib/dagu
WorkingDirectory=/var/lib/dagu

# Hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dagu
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
